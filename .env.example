# Environment variables for local tooling (the offline audio build pipeline, etc.)
#
# SETUP:
#   1. Copy this file to `.env`  ->  cp .env.example .env
#   2. Fill in the real values in `.env`
#   3. NEVER commit `.env` — it is gitignored. Only this `.env.example` is tracked.
#
# `.env` is consumed by Node tools via native env-file loading (Node >= 20.6):
#   node --env-file=.env tools/audio/build-audio.mjs --article all
# so the secret is read from process.env and never reaches any browser/client code.

# ElevenLabs API key — used only by the offline audio build pipeline (tools/audio/).
# Get one at https://elevenlabs.io/  ->  Profile  ->  API Keys
ELEVENLABS_API_KEY=

# Narration audiobook (v3) — TTS model + output format.
# v3 expressive read; ~5000-char-per-request limit; no request stitching.
ELEVENLABS_NARRATION_MODEL_ID=eleven_v3
# Creator tier: mp3_44100_192. Pro tier can switch to pcm_44100.
ELEVENLABS_NARRATION_OUTPUT_FORMAT=mp3_44100_192

# Anthropic (Claude) — the "Enhance" replica that adds sparse v3 delivery tags.
# Used only by the offline audio build pipeline (tools/audio/lib/tag.js).
# Get one at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
