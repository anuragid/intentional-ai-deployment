# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATION_VOICE_ID=
ELEVENLABS_PODCAST_HOST_VOICE_ID=
ELEVENLABS_PODCAST_GUEST_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Narration audiobook (v3) — TTS model + output format.
ELEVENLABS_NARRATION_MODEL_ID=eleven_v3
ELEVENLABS_NARRATION_OUTPUT_FORMAT=mp3_44100_192

# Anthropic (Claude) — "Enhance" replica that adds sparse v3 delivery tags.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Firebase Storage upload (service account JSON, gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_STORAGE_BUCKET=intentional-ai-deployment.firebasestorage.app
